{
  "name": "alexa-mcp-server",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:ui": "node scripts/build-ui.mjs",
    "dev": "npm run build:ui && tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "npm run build:ui && tsx --env-file-if-exists=../.env src/index.ts",
    "test": "npm run build:ui && vitest run",
    "typecheck": "tsc -p .",
    "fixture": "npm run build:ui && tsx scripts/fixture-server.ts",
    "lint:tools": "tsx scripts/lint-tools.ts"
  },
  "dependencies": {
    "@duffel/api": "^4.31.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
